@using Fanex.ApolloCMS.Message.Resources
@using Fanex.ApolloCMS.Core.Web
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/styles/fanexGrid")
    <link rel="stylesheet" type="text/css" href="~/Areas/Message/Views/MessageList/Message.less" />
}

<h2>Message List</h2>

<div class="filter-form">
    <div class="filter-row">
        <div class="filter-item">
            <label>@Labels.Top_New_Messages</label>
            <select id="ddlTopNewMessage">
                <option value="100">100</option>
                <option value="200">200</option>
                <option value="500">500</option>
            </select>
        </div>
        <div class="filter-item">
            <label>@Labels.Message_Type</label>
            <select id="ddlMessageType">
                <option value="All">All Types</option>
                <option value="3">Public</option>
                <option value="1">Private</option>
            </select>
        </div>
        <div class="filter-item">
            <label>@Labels.Special</label>
            <select id="ddlSpecial">
                <option value="All">All</option>
                <option value="1">Yes</option>
                <option value="0">No</option>
            </select>
        </div>
        <div class="clear"></div>
    </div>
    <div class="filter-row">
        <div class="filter-item">
            <label>@Labels.From</label>
            <input type="text" id="dateFrom"/>
        </div>
        <div class="filter-item">
            <label>@Labels.To</label>
            <input type="text" id="dateTo"/>
        </div>
        <div class="filter-item">
            <input id="btnGetListMessage" type="button" value="@Labels.Submit"/>
        </div>
        <div class="clear"></div>
    </div>
</div>

<div class="gridMessageContainer display-none content-grid width-100percent" id="gridMessageContainer">
    <div class="gridMessage freegrid" id="gridMessage"></div>
</div>
@section Foot {
    @Scripts.Render("~/scripts/fanexGrid")
    <script type="text/javascript" src="~/Scripts/lib/Namespace.js"></script>
    <script type="text/javascript" src="~/Areas/Message/Views/MessageList/Scripts/MessageList.js"></script>
}

