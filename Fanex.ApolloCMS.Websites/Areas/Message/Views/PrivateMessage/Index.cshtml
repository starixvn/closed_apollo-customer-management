@model Fanex.ApolloCMS.Message.Criteria.NewMessage.InsertMessageCriteria
@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head 
{
    @Styles.Render("~/site/newMessage")
}
@section Headline 
{
    <h5 class="row title">@Labels.NewPrivateMessage</h5>
}

<div class="panel">
    <div id="divEnglishLabel" class="panel-heading">
        @Html.LabelFor(m => m.ContentEn, Labels.English, new { @class = "language-title" }) <span class="icon-important"></span>
    </div>
    <div class="panel-body no-padding">
        @Html.TextAreaFor(m => m.ContentEn, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
    </div>
</div>
<div class="panel">
    <div class="panel-heading">
        @Html.LabelFor(m => m.ContentCh, Labels.ChineseTraditional, new { @class = "language-title" })
    </div>
    <div class="panel-body no-padding">
        @Html.TextAreaFor(m => m.ContentCh, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
    </div>
</div>
<div class="panel">
    <div class="panel-heading">
        @Html.LabelFor(m => m.ContentCs, Labels.ChineseSimplified, new { @class = "language-title" })
    </div>
    <div class="panel-body no-padding">
        @Html.TextAreaFor(m => m.ContentCs, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
    </div>
</div>
<div class="panel other-lag">
    <div id="divOtherLanguageTitle" class="panel-heading language-group-title">
        <span id="spanOtherLanguage" class="icon-exp-panel"></span>@Labels.OtherLanguage</div>
    <div id="divOtherLanguage" class="panel-body body-otherLanguage">
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentJp, Labels.Japanese, new { @class = "language-title noborder-right" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentJp, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentKo, Labels.Korean, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title noborder-right" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentKo, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentTh, Labels.Thai, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentTh, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentVn, Labels.Vietnamese, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentVn, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
    </div>
</div>
<div class="row">
    <div class="col-md-9 filter-form clearfix addMessage">
        <div class="pull-left">
            @Html.DropDownList("ddlMemberType", (IEnumerable<SelectListItem>)ViewBag.MemberTypes)
        </div>
        @Html.TextBox(
                  "txtUserName", 
                  null, 
                  new 
                  { 
                      @class = "pull-left txtUserName", 
                      data_val_required = Messages.RequiredMemberError, 
                      data_val_invalid_username = Messages.InvalidUserName, 
                      data_val_existing = Messages.ExistingUserNameError 
                  })
        <div class="checkbox pull-left">
            @Html.CheckBox("chkInformUpline")
            @Html.Label("chkInformUpline", Labels.AlsoInformUpline)
        </div>
        <button id="btnAdd" class="btn pull-left btn-add"><span class="icon-add"></span>@ViewLang.Add</button>
    </div>
    <div class="col-md-9 clearfix">
        <table id="tblMemberList" class="table table-bordered tbl">
            <thead>
                <tr>
                    <th>
                        #
                    </th>
                    <th>@ViewLang.UserName
                    </th>
                    <th class="width-100">@ViewLang.Level
                    </th>
                    <th class="width-100">@Labels.InformUpline
                    </th>
                    <th class="width-100">@ViewLang.Remove
                    </th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" class="text-center">@Labels.NoMember</td>
                </tr>
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="5" class="text-right">@Labels.MaxRowsLimit @ViewBag.MaxRowsLimit</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="col-md-9 clearfix">
        <input type="button" id="btnSubmit" class="btn btn-primary" value="@ViewLang.Submit" />
    </div>
</div>
@section Foot 
{
    <script type="text/javascript">
        var labels = {
            Agent: '@ViewLang.Agent',
            Member: '@ViewLang.Member',
            NoMember: '@Labels.NoMember'
        };
        var messages = {
            PostMessageSuccessfully: '@Messages.PostMessageSuccessfully'
        };
        var hasViewMessageRight = '@ViewBag.HasViewMessageRight' == 'True';
        var limitRows = '@ViewBag.MaxRowsLimit';
    </script>
    @Scripts.Render("~/scripts/newPrivateMessage")
}