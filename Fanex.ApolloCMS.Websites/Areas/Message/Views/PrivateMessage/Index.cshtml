@{
    ViewBag.Title = AppSession.CurrentWorkingOnMenu != null ? AppSession.CurrentWorkingOnMenu.Name : string.Empty;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@model Fanex.ApolloCMS.Message.Criteria.NewMessage.InsertMessageCriteria
@section Head {
    @Styles.Render("~/site/newMessage")
}
<h5 class="row title">@Labels.NewPrivateMessage</h5>
<div id="divMajorLangue" class="row language-group">
    <div class="col-xs-12 col-sm-12 col-md-12 language-group-title">@Labels.MajorLanguage</div>
    <div class="col-xs-12 col-sm-12 col-md-12 language-group-body">
        <div class="row group-row">
            <div class="col-sm-4 col-md-4 language-area">
                @Html.LabelFor(m => m.Content_En, Labels.English, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title noborder-right" })
                @Html.TextAreaFor(m => m.Content_En, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
            <div class="col-sm-4 col-md-4 language-area">
                @Html.LabelFor(m => m.Content_Ch, Labels.ChineseTraditional, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title noborder-right" })
                @Html.TextAreaFor(m => m.Content_Ch, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
            <div class="col-sm-4 col-md-4 language-area">
                @Html.LabelFor(m => m.Content_Cs, Labels.ChineseSimplified, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title" })
                @Html.TextAreaFor(m => m.Content_Cs, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
    </div>
</div>
<div class="row language-group">
    <div class="col-xs-12 col-sm-12 col-md-12 language-group-title other-lag">@Labels.OtherLanguage</div>
    <div class="col-xs-12 col-sm-12 col-md-12 language-group-body">
        <div class="row group-row">
            <div class="col-sm-4 col-md-4 language-area">
                @Html.LabelFor(m => m.Content_Jp, Labels.Japanese, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title noborder-right" })
                @Html.TextAreaFor(m => m.Content_Jp, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
            <div class="col-sm-4 col-md-4 language-area">
                @Html.LabelFor(m => m.Content_Ko, Labels.Korean, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title noborder-right" })
                @Html.TextAreaFor(m => m.Content_Ko, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
            <div class="col-sm-4 col-md-4 language-area">
                @Html.LabelFor(m => m.Content_Th, Labels.Thai, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title" })
                @Html.TextAreaFor(m => m.Content_Th, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
        <div class="row group-row">
            <div class="col-sm-4 col-md-4 language-area end-area">@Html.LabelFor(m => m.Content_Vn, Labels.Vietnamese, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title" })
                @Html.TextAreaFor(m => m.Content_Vn, new { id = "txtContentVn", @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
    </div>
</div>
<div class="row group-action">
    <div class="pull-left">
        @Html.DropDownList("ddlMemberType", (IEnumerable<SelectListItem>)ViewBag.MemberTypes)
    </div>
    @Html.TextBox("txtUserName", null, new { @class= "pull-left"})
    <div class="checkbox pull-left">
        @Html.CheckBox("chkInformUpline") @Labels.AlsoInformUpline
    </div>
    <input type="button" class="btn pull-left" value="@ViewLang.Add" />
</div>
<div class="row">
    <table class="col-md-10 table">
        <thead>
            <tr>
                <th>
                    #
                </th>
                <th>@ViewLang.UserName
                </th>
                <th>@ViewLang.Level
                </th>
                <th>@Labels.InformUpline
                </th>
                <th>@ViewLang.Edit
                </th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td colspan="6">@Labels.NoMember
                </td>
            </tr>
        </tbody>
    </table>
</div>
<div>
    <input type="button" value="@ViewLang.Submit" />
    <span>@Labels.MaxRowsLimit @ViewBag.MaxRowsLimit</span>
</div>
</div>