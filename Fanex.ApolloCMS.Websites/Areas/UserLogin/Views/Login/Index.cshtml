@using System.Web.Optimization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewResources.Log_In</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Styles.Render("~/site/common")
    @Styles.Render("~/site/login")
    @Scripts.Render("~/scripts/headjs")
</head>
<body>
    <div class="container login-page">
        <div id="not-supported-browser-panel" class="row not-supported-browser">
            Your browser is no longer supported. Some parts will not work and you may experience
            problems.<br />
            If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full
            browsing experience. Thank you!
        </div>
        <div class="row frm-login">
            @using (Html.BeginForm())
            {
                <div id="login-box" class="col-sm-12 col-md-12 login">
                    <div class="row header"></div>
                    <div class="row">
                        <div class="bg">
                            <input type="text" id="username" name="username" class="txt-username" value="Username" autocomplete="off" />
                            <div class="line"></div>
                            <input type="password" id="password" class="txt-pass" value="Password" name="password" />
                        </div>
                    </div>
                    <div class="row">
                        <input type="submit" class="btn-signin" id="submit" value="@ViewResources.Log_In" />
                    </div>
                    <div class="row" id="msg">
                        <div id="inner-msg" class="error">@ViewBag.Message</div>
                    </div>
                </div>
            }
        </div>
    </div>
     @Scripts.Render("~/scripts/loginJS")
