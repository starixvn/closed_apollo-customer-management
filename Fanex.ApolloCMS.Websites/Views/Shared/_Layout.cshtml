@using Fanex.NAP.Core.Web
@using Fanex.ApolloCMS.Core.Resources
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title &mdash; @ViewLang.CMS</title>
    <link rel="shortcut icon" href="~/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Styles.Render("~/site/layout")
    @Scripts.Render("~/scripts/headjs")
    @if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
    {
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"></script>
    }
    @RenderSection("Head", false)
</head>
<body>
    <div class="container page">
        <div class="row header">
            <div class="col-xs-3 col-sm-3 col-md-3 search">
                <ul class="row search-container list-unstyled">
                    <li class="selType">
                        <select>
                            <option value="0">Agent</option>
                            <option value="0">Member</option>
                        </select>
                    </li>
                    <li>
                        <input type="text" class="txtSearch" name="username" placeholder="Input an username..." />
                    </li>
                    <li>
                        <div class="search">
                            <span class="glyphicon glyphicon-search icon-search"></span>
                        </div>
                    </li>
                    <li>
                        <div class="treeview">
                            <span class="icon-treeview"></span>
                        </div>
                    </li>
                </ul>
            </div>
            <div class="col-xs-9 col-sm-9 col-md-9 rightHeader">
                <div class="col-xs-9 col-sm-9 col-md-9">
                    <ul class="mainMenu list-unstyled">
                        <li><a href="#">Message</a></li>
                        <li>Shareholder Bet Limit
                            <ul class="list-unstyled subMenu">
                                <li><a href="#">Submenu 1</a></li>
                                <li><a href="#">Submenu 2</a></li>
                                <li><a href="#">Submenu 3</a></li>
                                <li><a href="#">Submenu 4</a></li>
                            </ul>
                        </li>
                        <li><a href="#">Check User By IP</a></li>
                        <li><a href="#">View Log</a></li>
                    </ul>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="userInfo pull-right">
                        <div class="user">
                            Useraccount001 <span class="icon-config"></span>
                            <ul class="list-unstyled list-config">
                                <li><a href="#"><span class="glyphicon glyphicon-edit icon-changePass"></span>Change
                                    password</a></li>
                                <li><a href="#"><span class="glyphicon glyphicon-off"></span>Sign out</a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row content">
            <div id="leftContent" class="col-xs-3 col-sm-3 col-md-3 leftContent">
                <div class="row item">
                    <div class="col-xs-6 col-sm-6 col-md-6 text-left">
                        Agent</div>
                    <div class="col-xs-6 col-sm-6 col-md-6 text-right">
                        <a href="#">51111 <span class="glyphicon glyphicon-home icon-link-home"></span></a>
                    </div>
                </div>
                <div class="row item no-border">
                    <div class="col-xs-6 col-sm-6 col-md-6 text-left">
                        Upline Agent</div>
                    <div class="col-xs-6 col-sm-6 col-md-6 text-right">
                        <a href="#">5111 <span class="glyphicon glyphicon-home icon-link-home"></span></a>
                    </div>
                </div>
                <div class="row list-btn">
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <a href="#" class="btn-link">Agents</a>
                    </div>
                    <div class="col-xs-6 col-sm-6 col-md-6">
                        <a href="#" class="btn-link">Members</a>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12 col-sm-12 col-md-12">
                        <!-- Nav tabs -->
                        <ul class="nav nav-tabs">
                            <li class="active"><a href="#home" data-toggle="tab">Settings</a></li>
                            <li><a href="#profile" data-toggle="tab">Agents </a></li>
                            <li><a href="#messages" data-toggle="tab">Members</a></li>
                        </ul>
                        <!-- Tab panes -->
                        <div class="tab-content">
                            <div class="tab-pane active" id="home">
                                <ul class="super-menu list-unstyled">
                                    <li><a href="#"><span class="icon-row-right"></span>Share Setting</a></li>
                                    <li><a href="#"><span class="icon-row-right"></span>Bet and Comm Setting</a></li>
                                    <li><a href="#"><span class="icon-row-right"></span>Share Hierachy</a></li>
                                    <li><a href="#"><span class="icon-row-right"></span>Comm Hierachy</a></li>
                                    <li><a href="#"><span class="icon-row-right"></span>User Log</a></li>
                                </ul>
                            </div>
                            <div class="tab-pane" id="profile">
                                Agents</div>
                            <div class="tab-pane" id="messages">
                                Members</div>
                        </div>
                    </div>
                </div>
            </div>
            <div id="mainContent" class="col-xs-9 col-sm-9 col-md-9 mainContent">
                <span id="collapseExpand" class="collapse-expand icon-collapse" title="Collapse"></span>
                @RenderBody()
            </div>
        </div>
    </div>
    @Html.Hidden("RootURL", Url.Content("~/"))
    @Scripts.Render("~/scripts/commonJS")
    @RenderSection("Foot", false)
</body>
</html>
