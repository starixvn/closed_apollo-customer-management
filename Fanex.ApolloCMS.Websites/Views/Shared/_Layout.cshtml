@using Fanex.ApolloCMS.Core.Resources
@using Fanex.NAP.Core.Web
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title &mdash; @ViewLang.CMS</title>
    <link rel="shortcut icon" href="~/content/site/img/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @Styles.Render("~/site/common")
    @Scripts.Render("~/scripts/headjs")
    @if (ViewBag.ViewFlags != null && ViewBag.ViewFlags.IsReCheckin)
    {
        <script src="~/Areas/UserLogin/scripts/ReCheckIn.js" type="text/javascript"></script>
    }
    @RenderSection("Head", false)
    @Scripts.Render("~/scripts/repondjs")
</head>
<body>
    <div class="container page">
        <div class="row header">
            @{
                var leftContentStyle = string.Empty;
                var hasPermission = (bool)ViewBag.HasAccountManagementPermission;
                
                if (hasPermission)
                {
                    leftContentStyle = "col-xs-9 col-sm-9 col-md-10";
                    @Html.Action("_Search", new RouteValueDictionary(new { Controller = "Home", Area = "" }));
                }
                else
                {
                    leftContentStyle = "col-xs-12 col-sm-12 col-md-12";
                }
            }
            <div class="@leftContentStyle rightHeader" id="rightHeader">
                <div class="col-xs-9 col-sm-9 col-md-9">
                    @Html.Action("_Menu", new RouteValueDictionary(new { Controller = "Home", Area = "" }))
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="userInfo pull-right">
                        <div class="user">
                            @HttpContext.Current.User.Identity.Name <span class="icon-config"></span>
                            <ul class="list-unstyled list-config">
                                <li><a href="@Url.Action("UserProfile", "User", new { Area = "UserControl" })"><span
                                    class="icon-profile"></span>@ViewResources.Profile
                                </a></li>
                                <li><a href="@Url.Action("ChangePassword", "User", new { Area = "UserControl" })"><span
                                    class="glyphicon glyphicon-edit icon-changePass"></span>@ViewResources.Change_Password
                                </a></li>
                                <li><a href="@Url.Action("LogOut", "Login", new { Area = "UserLogin" })"><span class="glyphicon glyphicon-off">
                                </span>@ViewResources.Sign_Out
                                </a></li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row content">
            @if (hasPermission == true)
            {
                @Html.Action("_LeftPanel", new RouteValueDictionary(new { Controller = "Home", Area = "" }));
            }
            <div id="mainContent" class="@leftContentStyle mainContent">
                @if (hasPermission == true)
                {
                    <span id="collapseExpand" class="collapse-expand icon-collapse"></span>
                }
                <div class="row container-content">
                    @RenderSection("Headline", false)
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    @Html.Hidden("DatePickerButtonUrl", Url.Content("~/content/site/img/icon-cal-orange.jpg"))
    @Html.Hidden("RootURL", Url.Content("~/"))
    @Html.Hidden("UnAuthorizedRequestError", Messages.UnAuthorizedRequestError)
    @Html.Hidden("ResourceNotFoundError", Messages.ResourceNotFoundError)
    @Html.Hidden("InternalError", Messages.InternalError)
    @Scripts.Render("~/scripts/commonJS")
    @RenderSection("Foot", false)
</body>
</html>