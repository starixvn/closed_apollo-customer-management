@using Fanex.ApolloCMS.Core.Resources
<div id="searchPanel" class="col-xs-3 col-sm-3 col-md-2 search">
    <ul class="row search-container list-unstyled">
        <li class="selType">
            @Html.DropDownList("ddlMemberTypes", (IEnumerable<SelectListItem>)ViewBag.MemberTypes, new { @class = "ddlMemberTypes" })
        </li>
        <li>
            <div class="containSearch">
                <input type="text" class="txtSearch" name="username" placeholder="@ViewLang.InputUserName" />
                <span class="glyphicon glyphicon-search icon-search"></span>
            </div>
        </li>
        <li class="containTreeview">
            <div class="treeview">
                <span class="icon-treeview"></span>
            </div>
        </li>
    </ul>
</div>