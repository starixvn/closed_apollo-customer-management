@using Apollo.CMS.Core.Resources
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title &mdash; @ViewLang.CMS</title>
    <link rel="shortcut icon" href="~/content/site/img/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />    
    @Styles.Render("~/site/common")
    @Scripts.Render("~/scripts/headjs")
    @RenderSection("Head", false)
    @Scripts.Render("~/scripts/repondjs")
</head>
<body>
    <div class="container page">
        <div class="row content page-content">
            <div id="mainContent" class="col-xs-12 col-sm-12 col-md-12 mainContent">
                <div class="row container-content">
                    @RenderSection("Headline", false)
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
    @Scripts.Render("~/scripts/commonJS")
    @Scripts.Render("~/scripts/pageLayoutJS")
    @RenderSection("Foot", false)
</body>
</html>