@{
    ViewBag.Title = ViewLang.MessageList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/styles/fanexGrid")
    @Styles.Render("~/site/messageList")
    @Styles.Render("~/site/newMessage")
}
@section HeadLine {
    <h5 class="row title">@ViewLang.MessageList</h5>
}
<div class="row filter-form clearfix message-list resizable-form" id="message-list" data-original-width="862">
    <div class="filter-row clearfix">
        <div class="filter-item">
            <div class="lbl lbl-large">
                <label>@ViewLang.TopNewMessages</label>
            </div>
            <div class="txt width-auto">
                <select id="ddlTopNewMessage" class="topMessage">
                    <option value="100">100</option>
                    <option value="200">200</option>
                    <option value="500">500</option>
                </select>
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl lbl-small">
                <label>@ViewLang.From</label>
            </div>
            <div class="txt width-auto">
                <input type="text" id="dateFrom" data-val-required="@Messages.RequiredFieldError" data-val-date="@Messages.InvalidDateError" data-val-date-from="@string.Empty"/>
            </div>
        </div>
        <div class="filter-item dateTo">
            <div class="lbl width-auto">
                <label>@ViewLang.To</label>
            </div>
            <div class="txt width-auto">
                <input type="text" id="dateTo" data-val-required="@Messages.RequiredFieldError" data-val-date="@Messages.InvalidDateError" data-val-date-to="@Messages.DateRangeError"/>
            </div>
        </div>
        
    </div>
    <div class="filter-row clearfix">
        <div class="filter-item">
            <div class="lbl lbl-large">
                <label>@ViewLang.MessageType</label>
            </div>
            <div class="txt width-auto">
                <select id="ddlMessageType" class="messageType">
                    <option value="All">@ViewLang.AllTypes</option>
                    <option value="3">@ViewLang.Public</option>
                    <option value="1">@ViewLang.Private</option>
                </select>
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl lbl-small">
                <label>@ViewLang.Special</label>
            </div>
            <div class="txt width-auto">
                <select id="ddlSpecial" class="sel-special">
                    <option value="All">@ViewLang.All</option>
                    <option value="1">@ViewLang.Yes</option>
                    <option value="0">@ViewLang.No</option>
                </select>
            </div>
        </div>
        <div class="filter-item">
            <input id="btnGetListMessage" type="button" class="btn btn-default btn-submit" value="@ViewLang.Submit"/>
        </div>
    </div>
</div>

<div class="row gridMessageContainer display-none content-grid width-100percent" id="gridMessageContainer">
    <div class="gridMessage freegrid resizable-grid" id="gridMessage"></div>
</div>
<div id="editMessageContent"></div>
@section Foot {
    @Scripts.Render("~/scripts/fanexGrid")
    @Scripts.Render("~/scripts/messageList")
    <script type="text/javascript">
        var publicMessage = '@ViewLang.Public';
        var privateMessage = '@ViewLang.Private';
        var messageIsSpecial = '@ViewLang.Yes';
        var messageNotSpecial = '@ViewLang.No';
        var postedDate = '@ViewLang.PostedDate';
        var messageEnglish = '@ViewLang.MessageEnglish';
        var messageType = '@ViewLang.Type';
        var isSpecial = '@ViewLang.IsSpecical';
        var creator = '@ViewLang.Creator';
        var recipient = '@ViewLang.Recipient';
        var remove = '@ViewLang.Remove';
        var updateSuccessInform = '@ViewLang.UpdateMessageSuccessInform';
        var removeMessageConfirm = '@ViewLang.RemoveMessageConfirm';
        var today = '@DateTime.Now.ToShortDateString()';
        var minDate = '@ViewBag.MinDate';
        var hasHostRight = '@ViewBag.HasHostRight' == 'True';
        var isRedirected = '@ViewBag.IsRedirected' == 'True';
    </script>
}

