@{
    ViewBag.Title = ViewLang.MessageList;
    Layout = "~/Views/Shared/_PageLayout.cshtml";
}
@section Head {
    @Styles.Render("~/styles/fanexGrid")
    @Styles.Render("~/site/messageList")
    @Styles.Render("~/site/newMessage")
}
@section HeadLine {
    <h5 class="row title">@ViewLang.MessageList</h5>
}
<div class="row filter-form clearfix message-list resizable-form" id="divMsgFilterForm" data-original-width="862">
    <div class="filter-row clearfix">
        <div class="filter-item">
            <div class="lbl lbl-large">
                <label>@ViewLang.TopNewMessages</label>
            </div>
            <div class="txt width-auto">
                <select id="ddlTopNewMessage" class="top-message">
                    <option value="100">100</option>
                    <option value="200">200</option>
                    <option value="500">500</option>
                </select>
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl lbl-small">
                <label>@ViewLang.From</label>
            </div>
            <div class="txt width-auto">
                <input type="text" id="dpkFromDate" />
            </div>
        </div>
        <div class="filter-item dateTo">
            <div class="lbl width-auto">
                <label>@ViewLang.To</label>
            </div>
            <div class="txt width-auto">
                <input type="text" id="dpkToDate" />
            </div>
        </div>
    </div>
    <div class="filter-row clearfix">
        <div class="filter-item">
            <div class="lbl lbl-large">
                <label>@ViewLang.MessageType</label>
            </div>
            <div class="txt width-auto">
                <select id="ddlMessageType" class="message-type">
                    <option value="null">@ViewLang.AllTypes</option>
                    <option value="3">@ViewLang.Public</option>
                    <option value="1">@ViewLang.Private</option>
                </select>
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl lbl-small">
                <label>@ViewLang.Special</label>
            </div>
            <div class="txt width-auto">
                <select id="ddlSpecial" class="sel-special">
                    <option value="null">@ViewLang.All</option>
                    <option value="true">@ViewLang.Yes</option>
                    <option value="false">@ViewLang.No</option>
                </select>
            </div>
        </div>
        <div class="filter-item">
            <input id="btnSubmit" type="button" class="btn btn-default btn-submit" value="@ViewLang.Submit"/>
        </div>
    </div>
</div>

<div class="row grid-message-container display-none content-grid width-100percent" id="divMessageContainer">
    <div class="gridMessage freegrid resizable-grid" id="divMessage"></div>
</div>
<div id="editMessageContent"></div>
@section Foot {
    @Scripts.Render("~/scripts/fanexGrid")
    @Scripts.Render("~/scripts/messageList")
    <script type="text/javascript">
        var tableHeaders = {
            postedDate: '@ViewLang.PostedDate',
            messageEnglish: '@ViewLang.MessageEnglish',
            type: '@ViewLang.Type',
            isSpecial: '@ViewLang.IsSpecical',
            creator: '@ViewLang.Creator',
            recipient: '@ViewLang.Recipient',
            remove: '@ViewLang.Remove',
            edit: '@ViewLang.Edit'
        };
        var message = {
            removeMessageConfirm: '@ViewLang.RemoveMessageConfirm',
            updateSuccessInform: '@ViewLang.UpdateMessageSuccessInform',
            editMessage: '@ViewLang.EditMessage'
        };
        var hasHostRight = '@ViewBag.HasHostRight' == 'True';
        var isRedirected = '@ViewBag.IsRedirected' == 'True';
        var today = '@DateTime.Now.ToShortDateString()';
        var minDate = '@ViewBag.MinDate';
    </script>
}

