@using Apollo.CMS.Core.Constants
@model Apollo.CMS.Message.Criteria.NewMessage.InsertMessageCriteria
@{
    ViewBag.Title = ViewLang.NewPublicMessage;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head 
{
    @Styles.Render("~/site/newMessage")
}
@section Headline 
{
    <h5 class="row title">@ViewLang.NewPublicMessage</h5>
}
<div class="panel align-left">
    <div id="divEnglishLabel" class="panel-heading">
        @Html.LabelFor(m => m.ContentEn, ViewLang.English, new { @class = "language-title" }) <span class="icon-important"></span>
    </div>
    <div class="panel-body no-padding">
        @Html.TextAreaFor(m => m.ContentEn, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
    </div>
</div>
<div class="panel">
    <div class="panel-heading">
        @Html.LabelFor(m => m.ContentCh, ViewLang.ChineseTraditional, new { @class = "language-title" })
    </div>
    <div class="panel-body no-padding">
        @Html.TextAreaFor(m => m.ContentCh, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
    </div>
</div>
<div class="panel">
    <div class="panel-heading">
        @Html.LabelFor(m => m.ContentCs, ViewLang.ChineseSimplified, new { @class = "language-title" })
    </div>
    <div class="panel-body no-padding">
        @Html.TextAreaFor(m => m.ContentCs, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
    </div>
</div>
<div class="panel other-lag">
    <div id="divOtherLanguageTitle" class="panel-heading language-group-title">
        <span id="spanOtherLanguage" class="icon-exp-panel"></span>@ViewLang.OtherLanguage
    </div>
    <div id="divOtherLanguage" class="panel-body body-otherLanguage">
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentJp, ViewLang.Japanese, new { @class = "language-title noborder-right" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentJp, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentKo, ViewLang.Korean, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title noborder-right" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentKo, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentTh, ViewLang.Thai, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentTh, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
        <div class="panel">
            <div class="panel-heading">
                @Html.LabelFor(m => m.ContentVn, ViewLang.Vietnamese, new { @class = "col-xs-12 col-sm-12 col-md-12 language-title" })
            </div>
            <div class="panel-body no-padding">
                @Html.TextAreaFor(m => m.ContentVn, new { @class = "col-xs-12 col-sm-12 col-md-12 language-body" })
            </div>
        </div>
    </div>
</div>
<div class="filter-form">
    <div class="row">
        <div class="pull-left">
            @Html.LabelFor(m => m.Recipient, ViewLang.Recipient, new { @class = "lbl-recipient" })
            @Html.DropDownListFor(m => m.Recipient, (IEnumerable<SelectListItem>)ViewBag.Recipient)
        </div>
        <div class="pull-left checkbox">
            <label>@Html.CheckBoxFor(m => m.IsSpecialMsg) @ViewLang.SpecialMessage</label>
        </div>
        <input type="button" id="btnSubmit" class="btn pull-left" value="@ViewLang.Submit" />
    </div>
    <div id="divAgentLevels" class="row second-row collapse" data-val-required="@Messages.RequiredLevelError">
        <div class="row">
             <div class="pull-left">
                <label>@Html.RadioButton("AgentLevel", "HighLevelAgents", true) @ViewLang.HighLevelAgents</label>
            </div>
            <div class="pull-left checkbox">
                <label>@Html.RadioButton("AgentLevel", "AllLevels", false) @ViewLang.AllLevels</label>
            </div>
        </div>
       <hr class="separator" />
        <div class="row">
            <div class="pull-left checkbox no-marfinLeft">
                <label class="align-left">@Html.CheckBox("chkSuper", true, new { data_msg_target_id = (int)HighLevelAgents.Super }) @ViewLang.Super</label>
            </div>
            <div class="pull-left checkbox">
                <label>@Html.CheckBox("chkMainShareholder", true, new { data_msg_target_id = (int)HighLevelAgents.MainShareholder }) @ViewLang.MainShareholder</label>
            </div>
            <div class="pull-left checkbox">
                <label>@Html.CheckBox("chkShareholder", true, new { data_msg_target_id = (int)HighLevelAgents.Shareholder }) @ViewLang.Shareholder</label>
            </div>
            <div class="pull-left checkbox">
                <label>@Html.CheckBox("chkMainAgent", true, new { data_msg_target_id = (int)HighLevelAgents.MainAgent }) @ViewLang.MainAgent</label>
            </div>
        </div>
        
    </div>
</div>
@section Foot 
{
    <script type="text/javascript">
        var messages = {
            PostMessageSuccessfully: '@Messages.PostMessageSuccessfully'
        };
        var hasViewMessageRight = '@ViewBag.HasViewMessageRight' == 'True';
    </script>
    @Scripts.Render("~/scripts/newPublicMessage")
}
