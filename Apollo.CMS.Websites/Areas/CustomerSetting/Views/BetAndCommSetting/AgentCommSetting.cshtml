@using Apollo.CMS.CustomerSetting.ViewModels.BetAndCommSetting
@model AgentDiscountItem
@{
    var hasEditSettingRight = (bool)ViewBag.HasEditSettingPermission;
    var disable = hasEditSettingRight ? string.Empty : "disabled";
}
<div class="row commission agent">
    <div class="row commission-title">
        @ViewLang.Commission
        <span id="spnCommissionInfo" class="icon-info" title="@ViewLang.CommissionSettingInstructions"></span>
    </div>
    <div class="row" id="divCommission">
        <input type="hidden" id="hdnSportType" value="@Model.SportType"/>
        <input type="hidden" id="hdnBetType" value="@Model.BetType"/>
        <div class="row commission-row">
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="col-xs-6 col-sm-6 col-md-6 label-col">
                    <label for="txtLineA">@string.Format("{0} (%):", ViewLang.LineA)</label>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                    <input type="text"
                           id="txtLineA"
                           class="col-xs-6 col-sm-6 col-md-6 text-field"
                           value="@Model.DiscountA"
                           maxlength="14"
                           @disable
                           data-val-number="@Messages.InvalidValue"
                           data-val-range="@Messages.ValueRangeError"
                           data-range-min="0"
                           data-range-max="@Model.UplineMinDiscountA"/>
                    <div class="col-xs-5 col-sm-5 col-md-5 range-col">[0 - @Model.UplineMinDiscountA]</div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="col-xs-6 col-sm-6 col-md-6 label-col">
                    <label for="txtLineC">@string.Format("{0} (%):", ViewLang.LineC)</label>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                    <input type="text"
                           id="txtLineC"
                           class="col-xs-6 col-sm-6 col-md-6 text-field"
                           value="@Model.DiscountC"
                           maxlength="14"
                           @disable
                           data-val-number="@Messages.InvalidValue"
                           data-val-range="@Messages.ValueRangeError"
                           data-range-min="0"
                           data-range-max="@Model.UplineMinDiscountC"/>
                    <div class="col-xs-5 col-sm-5 col-md-5 range-col">[0 - @Model.UplineMinDiscountC]</div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="col-xs-6 col-sm-6 col-md-6 label-col">
                    <label for="txt1x2Comm">@string.Format("{0} (%):", ViewLang._1x2Comm)</label>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                    <input type="text"
                           id="txt1x2Comm"
                           class="col-xs-6 col-sm-6 col-md-6 text-field"
                           value="@Model.Discount1x2"
                           maxlength="14"
                           disabled="disabled"
                           data-val-number="@Messages.InvalidValue"
                           data-val-range="@Messages.ValueRangeError"
                           data-range-min="0"
                           data-range-max="@Model.UplineMinDiscount1x2"/>
                    <input type="hidden" id="hdnSportTyp1x2" value="@Model.SportType1x2"/>
                    <input type="hidden" id="hdnBetType1x2" value="@Model.BetType1x2"/>
                    <div class="col-xs-5 col-sm-5 col-md-5 range-col">[0]</div>
                </div>
            </div>
        </div>
        <div class="row commission-row">
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="col-xs-6 col-sm-6 col-md-6 label-col">
                    <label for="txtLineB">@string.Format("{0} (%):", ViewLang.LineB)</label>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                    <input type="text"
                           id="txtLineB"
                           class="col-xs-6 col-sm-6 col-md-6 text-field"
                           value="@Model.DiscountB"
                           maxlength="14"
                           @disable
                           data-val-number="@Messages.InvalidValue"
                           data-val-range="@Messages.ValueRangeError"
                           data-range-min="0"
                           data-range-max="@Model.UplineMinDiscountB"/>
                    <div class="col-xs-5 col-sm-5 col-md-5 range-col">[0 - @Model.UplineMinDiscountB]</div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="col-xs-6 col-sm-6 col-md-6 label-col">
                    <label for="txtLineD">@string.Format("{0} (%):", ViewLang.LineD)</label>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                    <input type="text"
                           id="txtLineD"
                           class="col-xs-6 col-sm-6 col-md-6 text-field"
                           value="@Model.DiscountD"
                           maxlength="14"
                           disabled="disabled"
                           data-val-number="@Messages.InvalidValue"
                           data-val-range="@Messages.ValueRangeError"
                           data-range-min="0"
                           data-range-max="@Model.UplineMinDiscountD"/>
                    <div class="col-xs-5 col-sm-5 col-md-5 range-col">[0]</div>
                </div>
            </div>
            <div class="col-xs-4 col-sm-4 col-md-4">
                <div class="col-xs-6 col-sm-6 col-md-6 label-col">
                    <label for="txtOthersComm">@string.Format("{0} (%):", ViewLang.OthersComm)</label>
                </div>
                <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                    <input type="text"
                           id="txtOthersComm"
                           class="col-xs-6 col-sm-6 col-md-6 text-field"
                           value="@Model.DiscountOthers"
                           maxlength="14"
                           disabled="disabled"
                           data-val-number="@Messages.InvalidValue"
                           data-val-range="@Messages.ValueRangeError"
                           data-range-min="@Model.DiscountOthers"
                           data-range-max="@Model.UplineMinDiscountOthers"/>
                    <input type="hidden" id="hdnSportTypeOthers" value="@Model.SportTypeOthers"/>
                    <input type="hidden" id="hdnBetTypeOthers" value="@Model.BetTypeOthers"/>
                    <div class="col-xs-5 col-sm-5 col-md-5 range-col">[0]</div>
                </div>
            </div>
        </div>
    </div>
</div>
