@using Apollo.CMS.CustomerSetting.ViewModels.BetAndCommSetting
@{
    var betLimits = (IEnumerable<SportBetLimitItem>)ViewBag.BetLimits;
}
<div class="commission">
    <div class="row commission-title">@ViewLang.BetLimit</div>
    <div class="row">
        <div class="col-xs-3 col-sm-3 col-md-3"></div>
        <div class="col-xs-3 col-sm-3 col-md-3 group-title">@ViewLang.SingleGame</div>
        <div class="col-xs-3 col-sm-3 col-md-3 group-title">@ViewLang.SingleBet</div>
        <div class="col-xs-3 col-sm-3 col-md-3 group-title">@ViewLang.MinSingleBet</div>
    </div>
    <div class="row">
        @foreach (SportBetLimitItem item in betLimits)
        {
            <div class="row commission-row">
                <div class="col-xs-3 col-sm-3 col-md-3">@item.SportName</div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                        <input type="text"
                               class="text-field"
                               value="@item.SingleGame"
                               data-range-error="@Messages.DiscountRangeError"
                               data-range-min="@item.MinOfSingleGame"
                               data-rang-max="@item.MaxOfSingleGame"/>
                    </div>
                    <div class="col-xs-6 col-sm-6 col-md-6 range-col">[@item.MinOfSingleGame - @item.MaxOfSingleGame]</div>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                        <input type="text"
                               class="text-field"
                               value="@item.SingleBet"
                               data-range-error="@Messages.DiscountRangeError"
                               data-range-min="@item.MinOfSingleBet"
                               data-rang-max="@item.MaxOfSingleBet"/>
                    </div>
                    <div class="col-xs-6 col-sm-6 col-md-6 range-col">[@item.MinOfSingleBet - @item.MaxOfSingleBet]</div>
                </div>
                <div class="col-xs-3 col-sm-3 col-md-3">
                    <div class="col-xs-6 col-sm-6 col-md-6 input-col">
                        <input type="text"
                               class="text-field"
                               value="@item.MinSingleBet"
                               data-greater-error="@Messages.GreaterThanError"
                               data-greater-value="@item.MinOfMinSingleBet"/>
                    </div>
                    <div class="col-xs-6 col-sm-6 col-md-6 range-col">[@item.MinOfSingleGame - @item.MaxOfSingleGame]</div>
                </div>
            </div>
        }
    </div>
</div>