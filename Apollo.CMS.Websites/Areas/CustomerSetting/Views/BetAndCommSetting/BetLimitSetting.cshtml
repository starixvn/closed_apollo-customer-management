@using Apollo.CMS.Core.Constants
@using Apollo.CMS.CustomerSetting.ViewModels.BetAndCommSetting
@model BetAndCommSettingFilter
@{
    var betLimits = (IEnumerable<BetLimitItem>)ViewBag.BetLimits;
    var hasEditSettingRight = (bool)ViewBag.HasEditSettingPermission;
    var disable = hasEditSettingRight ? string.Empty : "disabled";
    var rangeFormat = "[{0} - {1}]";
    var rangeValidationFormat = "data-val-range=\"" + Messages.ValueRangeError + "\" data-range-min={2} data-range-max={3}";
    var minSingleBetRangeFormat = ">={0}";

    if (!Model.IsMember && Model.Level < (int)HighLevelAgents.Shareholder)
    {
        rangeFormat = ">={0}";
        rangeValidationFormat = "data-val-greater=\"" + Messages.GreaterThanError + "\" data-greater-value={2}";
        minSingleBetRangeFormat = string.Empty;
    }
}
<div class="row commission">
    <div class="row commission-title">
        @ViewLang.BetLimit
        <span id="spnBetLimitInfo" class="icon-info"  title="@ViewLang.BetLimitInstruction"></span>
    </div>
    <div class="row">
        <div class="col-xs-2 col-sm-2 col-md-2 group-title">
        </div>
        <div class="col-xs-10 col-sm-10 col-md-10">
            <div class="col-xs-4 col-sm-4 col-md-4 group-title">@ViewLang.SingleGame</div>
            <div class="col-xs-4 col-sm-4 col-md-4 group-title">@ViewLang.SingleBet</div>
            <div class="col-xs-4 col-sm-4 col-md-4 group-title">@ViewLang.MinSingleBet</div>
        </div>
    </div>
    <div class="row" id="divBetLimit">
        @foreach (BetLimitItem item in betLimits)
        {
            <div class="row commission-row bet-setting">
                <div class="col-xs-2 col-sm-2 col-md-2 label-col text-left">
                    <input type="hidden" id="hdnSportType" value="@item.SportType"/>
                    <input type="hidden" id="hdnBetType" value="@item.BetType"/>
                    @item.SportTypeName
                    @if (item.IsSpecialSport && hasEditSettingRight)
                    {
                        <span class="icon-copy" title="@string.Format(Messages.CopyBetLimitMessage, item.SportTypeName)"></span>
                    }
                </div>
                <div class="col-xs-10 col-sm-10 col-md-10">
                    <div class="col-xs-4 col-sm-4 col-md-4 line-right">
                        <div class="col-xs-7 col-sm-7 col-md-7 input-col">
                            <input type="text"
                               class="text-field single-game"
                               value="@item.SingleGame"
                               maxlength="14"
                               @disable
                               data-val-number="@Messages.InvalidValue"
                               @Html.Raw(string.Format(rangeValidationFormat, "{0}", "{1}", item.MinOfSingleGame, item.MaxOfSingleGame))
                               data-greater-error="@Messages.GreaterThanError"/>
                        </div>
                        <div class="col-xs-5 col-sm-5 col-md-5 range-col">@string.Format(rangeFormat, item.MinOfSingleGame, item.MaxOfSingleGame)</div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4 line-right">
                        <div class="col-xs-7 col-sm-7 col-md-7 input-col">
                            <input type="text"
                               class="text-field single-bet"
                               value="@item.SingleBet"
                               maxlength="14"
                               @disable
                               data-val-number="@Messages.InvalidValue"
                               @Html.Raw(string.Format(rangeValidationFormat, "{0}", "{1}", item.MinOfSingleBet, item.MaxOfSingleBet))
                               data-greater-error="@Messages.GreaterThanError"/>
                        </div>
                        <div class="col-xs-5 col-sm-5 col-md-5 range-col">@string.Format(rangeFormat, item.MinOfSingleBet, item.MaxOfSingleBet)</div>
                    </div>
                    <div class="col-xs-4 col-sm-4 col-md-4">
                        <div class="col-xs-7 col-sm-7 col-md-7 input-col">
                            <input type="text"
                               class="text-field min-single-bet"
                               value="@item.MinSingleBet"
                               maxlength="14"
                               @disable
                               data-val-number="@Messages.InvalidValue"
                               data-val-greater="@Messages.GreaterThanError"
                               data-greater-value="@item.MinOfMinSingleBet"/>
                        </div>
                        <div class="col-xs-5 col-sm-5 col-md-5 range-col">@string.Format(minSingleBetRangeFormat, item.MinOfMinSingleBet)</div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
