@using Apollo.CMS.Core.Constants
@using Apollo.CMS.CustomerSetting.ViewModels.BetAndCommSetting
@model BetAndCommSettingFilter
@{
    var hasEditSettingRight = (bool)ViewBag.HasEditSettingPermission;
    var parameters = new RouteValueDictionary(Model);

    ViewBag.Title = ViewLang.BetAndCommSetting;
    Layout = "~/Views/Shared/_PageLayout.cshtml";
    parameters.Add("Area", "CustomerSetting");
}
@section Head {
    @Styles.Render("~/site/betAndCommSetting")
}
@section HeadLine {
    <h5 class="row title">@ViewBag.Title - @Model.Username</h5>
}
<div class="setting-form">
    @Html.Action("CommSetting", "BetAndCommSetting", parameters)
    @Html.Action("BetLimitSetting", "BetAndCommSetting", parameters)
    @if (hasEditSettingRight)
    {
        <div class="row action">
            <input type="button" id="btnSubmit" class="btn btn-primary" value="@ViewLang.Submit" />
        </div>
    }
    <div class="hide">
        @if (Model.IsMember)
        {
            Html.RenderPartial("MemberCommInstructions");
            Html.RenderPartial("MemberBetLimitInstructions");
        }
        else if (Model.Level < (int)HighLevelAgents.Shareholder)
        {
            Html.RenderPartial("MainShareholderCommInstructions");
            Html.RenderPartial("MainShareholderBetLimitInstructions");
        }
        else
        {
            Html.RenderPartial("AgentCommInstructions");
            Html.RenderPartial("AgentBetLimitInstructions");
        }
    </div>
</div>
@section Foot {
    @Scripts.Render("~/scripts/betAndCommSetting")
    <script type="text/javascript">
        var hasEditSettingRight = '@hasEditSettingRight' === 'True';
        var filter = {
            custId: '@Model.CustId',
            uplineId: '@Model.UplineId',
            isMember: '@Model.IsMember' === 'True'
        };
        var messages = {
            updateMessage: '@Messages.UpdateSettingsSuccessfully',
            commissionSettingInstructions: '@ViewLang.CommissionSettingInstructions',
            betLimitInstruction: '@ViewLang.BetLimitInstruction',
            updateSettingConfirmMsg: '@Messages.UpdateSettingsConfirmMessage',
            noChange: '@Messages.NoChangeMessage'
        };
    </script>
}