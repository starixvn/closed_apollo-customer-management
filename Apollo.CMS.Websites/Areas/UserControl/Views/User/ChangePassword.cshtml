@using Apollo.CMS.Core.Resources
@using Apollo.CMS.Core.Web
@using Fanex.NAP.Core.Web
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_PageLayout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
    string message = ViewBag.Message != null ? ViewBag.Message : string.Empty;
}
@section Headline {
    <h5 class="row title">
        <span>@AppSession.CurrentUser.Username / </span><span class="curr">@ViewBag.Title</span></h5>
}
@using (Html.BeginForm())
{
<div class="row form-horizontal frm">
    <div class="form-group">
        <label for="OldUserPwd" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.Old_Password</label>
        <div class="col-xs-5 col-sm-3 col-md-3">
            <input type="password" id="OldUserPwd" name="OldUserPwd" class="form-control" />
        </div>
    </div>
    <div class="form-group">
        <label for="UserPwd" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.New_Password</label>
        <div class="col-xs-5 col-sm-3 col-md-3">
            <input type="password" id="UserPwd" name="UserPwd" class="form-control" />
        </div>
    </div>
    <div class="form-group">
        <label for="ConfirmUserPwd" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.Confirm_Password</label>
        <div class="col-xs-5 col-sm-3 col-md-3">
            <input type="password" id="ConfirmUserPwd" name="ConfirmUserPwd" class="form-control" />
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10 grp-action">
            <input id="btnSave" name="btnGenerate" type="submit" value="Save" class="btn btn-left" />
            <input id="btnCancel" name="btnGenerate" type="button" value="Cancel" class="btn" />
        </div>
    </div>
</div>
}
@section Foot {
    <script type="text/javascript">
     var success = @success.ToString().ToLower();
     var message = '@message';
     $(function () { 
        if(success == true)
        {
            CMS.showInfoMessage('@Messages.ChangedPassword');
        }
        else if(message != '')
        {
            CMS.showInfoMessage(message);
        }

        $("#btnSave").on("click",function(){
            //AccReport.popUp.removeHighLight();
            var oldPass = $("#OldUserPwd").val();
            var newPass = $("#UserPwd").val();
            var confirmPass = $("#ConfirmUserPwd").val();
            if(oldPass == "")
            {
                CMS.showErrorMessage('@Messages.OldPasswordCannotEmpty', "OldUserPwd");
                return false;
            } 
            else if(newPass == "")
            {
                CMS.showErrorMessage('@Messages.NewPasswordCannotEmpty', "UserPwd");
                return false;
            }
            else if(confirmPass == "" )
            {
                CMS.showErrorMessage('@Messages.ConfirmPasswordCannotEmpty', "ConfirmUserPwd");
                return false;
            } 
            else if(newPass != confirmPass)
            {
                CMS.showErrorMessage('@Messages.PasswordDoesNotMatch', "ConfirmUserPwd");
                return false;
            } 
            else if(newPass.length < 5)
            {
                CMS.showErrorMessage('@Messages.PasswordMinLengthError', "UserPwd");
                return false;
            }
        });

        $("#btnCancel").on("click",function(){
            window.location.href = '@Url.Action("Index", "Home", new { Area = "" })';
            return false;
        });
     })
    </script>
}
