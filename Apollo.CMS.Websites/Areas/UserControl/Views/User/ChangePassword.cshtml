@using Apollo.CMS.Core.Resources
@using Apollo.CMS.Core.Web
@using Fanex.NAP.Core.Web
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/_PageLayout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
    string message = ViewBag.Message != null ? ViewBag.Message : string.Empty;
}
@section Headline {
    <h5 class="row title">
        <span>@AppSession.CurrentUser.Username / </span><span class="curr">@ViewBag.Title</span></h5>
}
@using (Html.BeginForm())
{
    <input type ="hidden" id="hdnToken" name="token" value="@ViewBag.ChangePasswordToken" />
    <div class="row form-horizontal frm">
        <div class="form-group">
            <label for="OldUserPwd" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.Old_Password</label>
            <div class="col-xs-5 col-sm-3 col-md-3">
                <input type="password" id="txtOldUserPwd" class="form-control" />
                <input type="hidden" id="hdnOldUserPwd" name="OldUserPwd" />
            </div>
        </div>
        <div class="form-group">
            <label for="UserPwd" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.New_Password</label>
            <div class="col-xs-5 col-sm-3 col-md-3">
                <input type="password" id="txtUserPwd" class="form-control" />
                <input type="hidden" id="hdnUserPwd" name="UserPwd" />
            </div>
        </div>
        <div class="form-group">
            <label for="ConfirmUserPwd" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.Confirm_Password</label>
            <div class="col-xs-5 col-sm-3 col-md-3">
                <input type="password" id="txtConfirmUserPwd" class="form-control" />
                <input type="hidden" id="hdnConfirmUserPwd" name="ConfirmUserPwd" />
            </div>
        </div>
        <div class="form-group">
            <div class="col-sm-offset-2 col-sm-10 grp-action">
                <input id="btnSave" name="btnGenerate" type="submit" value="Save" class="btn btn-left" />
                <input id="btnCancel" name="btnGenerate" type="button" value="Cancel" class="btn" />
            </div>
        </div>
    </div>
}
@section Foot {
    @Scripts.Render("~/scripts/crypto")
    <script type="text/javascript">
     var success = @success.ToString().ToLower();
     var message = '@message';

     $(function () { 
        if(success == true)
        {
            CMS.showInfoMessage('@Messages.ChangedPassword');
        }
        else if(message != '')
        {
            CMS.showErrorMessage(message);
        }

        $("#btnSave").on("click",function(){
            var oldPass = $("#txtOldUserPwd");
            var newPass = $("#txtUserPwd");
            var confirmPass = $("#txtConfirmUserPwd");
            var token = $('#hdnToken').val();
            var encryptPass = '';

            if(oldPass.val() === "")
            {
                CMS.showErrorMessage('@Messages.OldPasswordCannotEmpty');
                return false;
            } 
            else if(newPass.val() === "")
            {
                CMS.showErrorMessage('@Messages.NewPasswordCannotEmpty');
                return false;
            }
            else if(confirmPass.val() == "" )
            {
                CMS.showErrorMessage('@Messages.ConfirmPasswordCannotEmpty');
                return false;
            } 
            else if(newPass.val() !== confirmPass.val())
            {
                CMS.showErrorMessage('@Messages.PasswordDoesNotMatch');
                return false;
            } 
            else if(newPass.val().length < 5)
            {
                CMS.showErrorMessage('@Messages.PasswordMinLengthError');
                return false;
            }

            encryptPass = CryptoJS.CfsEnCode(oldPass.val());
            $('#hdnOldUserPwd').val(CryptoJS.SHA256(encryptPass + token));

            encryptPass = CryptoJS.CfsEnCode(newPass.val());
            $('#hdnUserPwd').val(encryptPass);

            encryptPass = CryptoJS.CfsEnCode(confirmPass.val());
            $('#hdnConfirmUserPwd').val(encryptPass);
        });

        $("#btnCancel").on("click",function(){
            window.location.href = '@Url.Action("Index", "Home", new { Area = "" })';
            return false;
        });
     })
    </script>
}
