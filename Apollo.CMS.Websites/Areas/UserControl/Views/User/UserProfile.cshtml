@using Apollo.CMS.Core.Resources
@using Apollo.CMS.Core.Web
@using Fanex.NAP.Core.Criteria.User
@using Fanex.NAP.Core.Web
@model UpdateCustCriteria
@{
    ViewBag.Title = "Profile";
    Layout = "~/Views/Shared/_PageLayout.cshtml";
    bool success = ViewBag.Success != null && ViewBag.Success;
    string message = ViewBag.Message != null ? ViewBag.Message : string.Empty;
}
@section Headline {
    <h5 class="row title"><span>@AppSession.CurrentUser.Username / </span><span class="curr">@ViewBag.Title</span></h5>
}
@using (Html.BeginForm())
{
<div class="row form-horizontal frm">
    <div class="form-group">
        <label for="FirstName" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.First_Name</label>
        <div class="col-xs-5 col-sm-3 col-md-3">
            <input type="text" id="FirstName" name="FirstName" class="form-control" value="@Model.FirstName" />
        </div>
    </div>
    <div class="form-group">
        <label for="LastName" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.Last_Name</label>
        <div class="col-xs-5 col-sm-3 col-md-3">
            <input type="text" id="LastName" name="LastName" class="form-control" value="@Model.LastName" />
        </div>
    </div>
    <div class="form-group">
        <label for="Email" class="col-xs-2 col-sm-2 col-md-2 control-label">@ViewResources.Email</label>
        <div class="col-xs-5 col-sm-3 col-md-3">
            <input type="text" id="Email" name="Email" class="form-control" value="@Model.Email"  />
        </div>
    </div>
    <div class="form-group">
        <div class="col-sm-offset-2 col-sm-10 grp-action">
            <input id="btnSave" name="btnGenerate" type="submit" value="Save" class="btn btn-left" />
            <input id="btnCancel" name="btnGenerate" type="button" value="Cancel" class="btn" />
        </div>
    </div>
</div>
}
@section Foot {

 <script type="text/javascript">
     var success = @success.ToString().ToLower();
     var message = '@message';
     var re = @Html.Raw(@"/\S+@\S+\.\S+/");
     $(function () { 
        if(success == true)
        {
            AccReport.popUp.show('@Messages.ChangedProfile', null, 1);
        }
        else if(message != '')
        {
            AccReport.popUp.show(message);
        }

        $("#btnSave").on("click",function(){
            var email = $("#Email").val();
            if(email != "" 
            && !re.test(email))
            {
                AccReport.popUp.show('@Messages.InvalidEmail', "Email");
                return false;
            }
        });

        $("#btnCancel").on("click",function(){
            window.location.href = '@Url.Action("Index","Home", new { Area = "" })';
            return false;
        });
     })
 </script>
}