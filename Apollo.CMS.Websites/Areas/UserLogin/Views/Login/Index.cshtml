@using System.Web.Optimization
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewResources.Log_In</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="shortcut icon" href="~/content/site/img/favicon.ico" />
    @Styles.Render("~/site/common")
    @Styles.Render("~/site/login")
    @Scripts.Render("~/scripts/headjs")
</head>
<body>
    <div class="container login-page">
        <div id="divWarningPanel" class="row not-supported-browser">
            Your browser is no longer supported. Some parts will not work and you may experience
            problems.<br />
            If you are having problems, try <a href='http://browsehappy.com/'>this</a> for full
            browsing experience. Thank you!
        </div>
        <div class="row frm-login">
            @using (Html.BeginForm())
            {
                <div id="login-box" class="col-sm-12 col-md-12 login">
                    <div class="row header"></div>
                    <div class="row">
                        <div class="bg">
                            <input type="text" id="txtUsername" name="username" class="txt-username" value="Username" autocomplete="off" />
                            <div class="line"></div>
                            <input type="password" id="txtPassword" class="txt-pass" value="Password" />
                            <input type ="hidden" id="hdnPassword" name="password" />
                            <input type ="hidden" id="hdnLoginToken" name="loginToken" value="@ViewBag.LoginToken" />
                        </div>
                    </div>
                    <div class="row">
                        <input type="submit" class="btn-signin" id="btnSubmit" value="@ViewResources.Log_In" />
                    </div>
                    <div class="row" id="divMessage">
                        <div id="divInnerMsg" class="error">@ViewBag.Message</div>
                    </div>
                </div>
            }
        </div>
    </div>
     @Scripts.Render("~/scripts/loginJS")
</body>
</html>