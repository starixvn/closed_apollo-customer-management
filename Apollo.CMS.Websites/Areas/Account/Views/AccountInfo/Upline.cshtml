@using Apollo.CMS.Account.Models.AccountInfo
@{
    var uplineList = (IEnumerable<UplineAgent>)ViewBag.UplineList;
}

@if ((uplineList != null) && (uplineList.Count() > 0))
{
    <div class="row item no-border view-more">
        <div class="col-xs-12 col-sm-12 col-md-12 text-right">
            <div href="javascript:;" id="show-upline" class="upline-agent">
                <span class="view-more" id="view-more">@ViewLang.ViewMoreUpline</span> <span class="icon-upline" id="icon-more"></span>            
                <ul class="list-agent list-unstyled" id="list-agent">
                    @foreach (var item in uplineList)
                    {
                        var level = string.Empty;
                        var superClass = string.Empty;

                        if (item.ParentId == null)
                        {
                            superClass = "icon-super";
                        }
                        else
                        {
                            level = string.Format("{0} {1}", ViewLang.Lv, item.AgentLevel);
                        }
                        
                        <li>
                            <span class="level pull-left @superClass">@level</span>
                            <a href="#" class="pull-right search-link" data-customer-id="@item.AgentId">@item.Username</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
}