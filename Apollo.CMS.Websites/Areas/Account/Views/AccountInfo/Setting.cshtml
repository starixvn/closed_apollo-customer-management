@{
    var hasCustomerSettingPermission = (bool)ViewBag.HasCustomerSettingPermission;

    if (hasCustomerSettingPermission)
    {
        <div class="tab-pane active" id="setting">
            <ul class="super-menu list-unstyled">
                <li><a href="#"><span class="icon-row-right"></span>@ViewLang.ShareSetting</a></li>
                <li><a href="#"><span class="icon-row-right"></span>@ViewLang.BetAndCommSetting</a></li>
                <li><a href="#"><span class="icon-row-right"></span>@ViewLang.ShareHierachy</a></li>
                <li><a href="#"><span class="icon-row-right"></span>@ViewLang.CommHierachy</a></li>
                <li><a href="#"><span class="icon-row-right"></span>@ViewLang.UserLog</a></li>
            </ul>
        </div>
    }
}
