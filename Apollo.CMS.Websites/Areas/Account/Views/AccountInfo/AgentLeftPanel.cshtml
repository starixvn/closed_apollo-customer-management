@using Apollo.CMS.Account.Models.AccountInfo
@using Apollo.CMS.Core.Extensions
@{
    var customer = (AgentInfo)ViewBag.Customer;
}
<div id="leftContent" class="col-xs-3 col-sm-3 col-md-2 leftContent">
    <div class="row item">
        <div class="col-xs-6 col-sm-6 col-md-6 text-left">
            Agent
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-right">
            <a href="#">51111 <span class="glyphicon glyphicon-home icon-link-home"></span></a>
        </div>
    </div>
    <div class="row item">
        <div class="col-xs-6 col-sm-6 col-md-6 text-left">
            @ViewLang.Upline
        </div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-right">
            <a href="#">5111 <span class="glyphicon glyphicon-home icon-link-home"></span></a>
        </div>
    </div>
    <div class="row item no-border view-more">
        <div class="col-xs-12 col-sm-12 col-md-12 text-right">
            <div href="javascript:;" id="show-upline" class="upline-agent">
            <span class="view-more" id="view-more">View more upline</span> <span class="icon-upline" id="icon-more"></span>
                <ul class="list-agent list-unstyled" id="list-agent">
                    <li><span class="level pull-left">Lv.2</span><a href="#" class="pull-right">511</a></li>
                    <li><span class="level pull-left">Lv.1</span><a href="#" class="pull-right">51</a></li>
                    <li><span class="level icon-super pull-left"></span><a href="#" class="pull-right">Super</a></li>
                </ul>
            </div>
        </div>
    </div>
    <div class="row list-btn">
            <div class="col-md-12">
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <a href="#" class="btn-link no-marginLeft">Agent</a>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <a href="#" class="btn-link">Member</a>
                </div>
                <div class="col-xs-12 col-sm-4 col-md-4">
                    <a href="#" class="btn-link">Shadow</a>
                </div>
            </div>
            @*<div class="col-xs-12 col-sm-12 col-md-12">
                <a href="#" class="btn-link no-marginLeft only">Bet List</a>
            </div>*@
    </div>
    <div class="row account-info">
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">Currency</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="currency">USD</b></div>
        </div>
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">Account Status</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="active">Active</b></div>
        </div>
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">Bet Status</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="locked">Locked</b></div>
        </div>
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">Sport Credit</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="credit">@customer.SportCredit.Format(2)</b></div>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <!-- Nav tabs -->
            <!--<ul class="nav nav-tabs search-member">-->
            <ul class="nav nav-tabs">
                <li class="setting active"><a href="#home" data-toggle="tab">Setting</a></li>
                <li><a href="#agent" data-toggle="tab">Agent</a></li>
                <li><a href="#member" data-toggle="tab">Member</a></li>
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <div class="tab-pane active" id="home">
                    <ul class="super-menu list-unstyled">
                        <li><a href="#"><span class="icon-row-right"></span>Share Setting</a></li>
                        <li><a href="#"><span class="icon-row-right"></span>Bet and Comm Setting</a></li>
                        <li><a href="#"><span class="icon-row-right"></span>Share Hierachy</a></li>
                        <li><a href="#"><span class="icon-row-right"></span>Comm Hierachy</a></li>
                        <li><a href="#"><span class="icon-row-right"></span>User Log</a></li>
                    </ul>
                </div>
                <div class="tab-pane" id="agent">
                    Agents
                </div>
                <div class="tab-pane" id="member">
                    Members
                </div>
            </div>
        </div>
    </div>
</div>