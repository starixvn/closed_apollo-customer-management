@using Apollo.CMS.Account.Models.AccountInfo
@using Apollo.CMS.Account.ViewModels.AccountInfo
@using Apollo.CMS.Core.Constants
@using Apollo.CMS.Core.Helpers
@using Apollo.CMS.Core.Services
@using Fanex.Common
@using Fanex.NAP.Core.Web
@{
    var hasCustomerSettingPermission = (bool)ViewBag.HasEditSettingPermission;
    var hasLoginInternallyPermission = (bool)ViewBag.HasLoginAgentSitePermission;
    var customer = (AgentInfo)ViewBag.Customer;
}
@if (customer == null)
{
    <div class="text-center nodata">@Messages.SearchAnAccount</div>
}
else if (customer.AgentId != 0)
{
    var accountStatus = StatusHelper.GetStatus(customer.Status, customer.UplineStatus);
    var betStatus = StatusHelper.GetStatus(customer.BetStatus, customer.UplineBetStatus);
    var isHighLevel = customer.AgentLevel < (int)HighLevelAgents.MainAgent;
    var noBorderCss = customer.ParentId == null ? "no-border" : string.Empty;
    var buttonCss = isHighLevel ? "col-xs-12 col-sm-6 col-md-6" : "col-xs-12 col-sm-4 col-md-4";
    var tabCss = isHighLevel ? "high-level-tab" : string.Empty;
    var internalLoginLinkAttr = string.Empty;

    @Html.Hidden("hdnCustomerId", customer.AgentId);

    <div class="row item @noBorderCss">
        <div class="col-xs-3 col-sm-3 col-md-3 text-left">@ViewLang.Agent</div>
        <div id="divAgentName" class="col-xs-9 col-sm-9 col-md-9 text-right">
            @customer.Username
            @if (hasLoginInternallyPermission)
            {
                internalLoginLinkAttr = ViewLang.Active.Equals(accountStatus, StringComparison.OrdinalIgnoreCase) ?
                    string.Format("data-agent-id=\"{0}\"", customer.AgentId) :
                    string.Format("data-login-error=\"{0}\"", Messages.PreventLoginAgentSiteError);

                <span class="glyphicon glyphicon-home icon-link-home" @Html.Raw(internalLoginLinkAttr)></span>
            }
        </div>
    </div>

    <!-- Hide Upline when searched account is Super -->
    if (customer.ParentId != null)
    {
        <div class="row item no-border">
            <div class="col-xs-3 col-sm-3 col-md-3 text-left">@ViewLang.Upline</div>
            <div class="col-xs-9 col-sm-9 col-md-9 text-right">
                <a href="#" class="search-link" data-customer-id="@customer.ParentId">@customer.ParentUsername</a>
                @if (hasLoginInternallyPermission)
                {
                    if ((int)AccountStatus.Active == Converter.ToInt(customer.UplineStatus) &&
                        (int)AccountStatus.Active == Converter.ToInt(customer.ParentStatus))
                    {
                        internalLoginLinkAttr = string.Format("data-agent-id=\"{0}\"", customer.ParentId);
                    }
                    else
                    {
                        internalLoginLinkAttr = string.Format("data-login-error=\"{0}\"", Messages.PreventLoginAgentSiteError);
                    }

                    <span class="glyphicon glyphicon-home icon-link-home" @Html.Raw(internalLoginLinkAttr)></span>
                }
            </div>
        </div>

        Html.RenderAction("UplineAgents", "AccountInfo", new { agentId = customer.ParentId });
    }

    <div class="row list-btn">
        <div class="col-md-12">
            <div class="@buttonCss">
                @Html.ActionLink(ViewLang.Agent, "AgentList", "AccountList", new { agentId = customer.AgentId, agentLevel = customer.AgentLevel }, new { @class = "btn-link no-marginLeft", id = "lnkAgentList" })
            </div>
            
            <!-- Hide Member button when searched account is Super, Main Shareholder or Shareolder -->
            @if (!isHighLevel)
            {
                <div class="@buttonCss">
                    @Html.ActionLink(ViewLang.Member, "MemberList", "AccountList", new { agentId = customer.AgentId, agentLevel = customer.AgentLevel }, new { @class = "btn-link", id = "lnkMemberList" })
                </div>
            }
            <div class="@buttonCss">
                @Html.ActionLink(ViewLang.Shadow, "ShadowList", "AccountList", new { agentId = customer.AgentId, agentLevel = customer.AgentLevel }, new { @class = "btn-link", id = "lnkShadowList" })
            </div>
        </div>
    </div>
    <div class="row account-info">
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.Currency</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right">
                <b class="currency">@(customer.ParentId == null ? ViewLang.NA : customer.Currency)</b>
            </div>
        </div>
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.AccountStatus</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right">
                <b class="@accountStatus.ToLower().Replace(".", string.Empty)">@accountStatus</b>
            </div>
        </div>
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.BetStatus</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right">
                <b class="@betStatus.ToLower().Replace(".", string.Empty)">@betStatus</b>
            </div>
        </div>
        <div class="row item-info">
            <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.SportCredit</div>
            <div class="col-xs-6 col-sm-6 col-md-6 text-right">
                <b class="credit">@Converter.ToDecimal(customer.SportCredit).Format(2)</b>
            </div>
        </div>
    </div>
    <div class="row tab-list">
        <div class="col-xs-12 col-sm-12 col-md-12">
            <!-- Nav tabs -->
            <ul class="nav nav-tabs @tabCss">
            @{
                var activeClass = string.Empty;

                <!-- Hide Setting tab when logged in user does not have permission on setting function -->
                if (hasCustomerSettingPermission)
                {
                        <li class="setting active"><a href="#setting" data-toggle="tab">@ViewLang.Setting</a></li>
                }
                else
                {
                    activeClass = "active";
                }
            }
            <li class="agent @activeClass"><a href="#agent" data-toggle="tab">@ViewLang.Agent</a></li>

            <!-- Hide Member tab when searched account is Super, Main Shareholder or Shareolder -->
            @if (!isHighLevel)
            {
                <li><a href="#member" data-toggle="tab">@ViewLang.Member</a></li>
            }
            </ul>
            <!-- Tab panes -->
            <div class="tab-content">
                <!-- Hide Setting tab when logged in user does not have permission on setting function -->
                @if (hasCustomerSettingPermission)
                {
                    var customerInfo = new CustomerInfo(customer);

                    Html.RenderPartial("Setting", customerInfo);
                }
                <div class="tab-pane @activeClass" id="agent">
                    <!-- Automatically load agent list when setting tab is hidden -->
                    @if (!hasCustomerSettingPermission)
                    {
                        Html.RenderAction("GetDownlineAgents", "AccountInfo", new { ParentId = customer.AgentId });
                    }
                </div>
                @if (!isHighLevel)
                {
                    <div class="tab-pane" id="member"></div>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="text-center nodata">@ViewLang.NoData</div>
}