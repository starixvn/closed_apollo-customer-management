@using Apollo.CMS.Account.Models.AccountInfo
@using Apollo.CMS.Core.Extensions
@using Apollo.CMS.Core.Helpers
@using Apollo.CMS.Core.Services
@{
    var customer = (MemberInfo)ViewBag.Customer;
}

<div class="row item">
    <div class="col-xs-6 col-sm-6 col-md-6 text-left">
        @ViewLang.Member
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 text-right">
        <a href="#">@customer.Username<span class="glyphicon glyphicon-home icon-link-home"></span></a>
    </div>
</div>
<div class="row item">
    <div class="col-xs-6 col-sm-6 col-md-6 text-left">
        @ViewLang.Upline
    </div>
    <div class="col-xs-6 col-sm-6 col-md-6 text-right">
        <a href="#">@customer.AgentUsername<span class="glyphicon glyphicon-home icon-link-home"></span></a>
    </div>
</div>
<div class="row item no-border view-more">
    <div class="col-xs-12 col-sm-12 col-md-12 text-right">
        <div href="javascript:;" id="show-upline" class="upline-agent">
            <span class="view-more" id="view-more">@ViewLang.ViewMoreUpline</span> <span class="icon-upline" id="icon-more"></span>            
        </div>
    </div>
</div>
<div class="row list-btn">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <a href="#" class="btn-link no-marginLeft only">@ViewLang.BetList</a>
    </div>
</div>
<div class="row account-info">
    <div class="row item-info">
        <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.Currency</div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="currency">@customer.Currency</b></div>
    </div>
    <div class="row item-info">
        <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.AccountStatus</div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="active">@StatusHelper.GetStatus(customer.Status, customer.UplineStatus)</b></div>
    </div>
    <div class="row item-info">
        <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.BetStatus</div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="locked">@StatusHelper.GetStatus(customer.BetStatus, customer.UplineBetStatus)</b></div>
    </div>
    <div class="row item-info">
        <div class="col-xs-6 col-sm-6 col-md-6">@ViewLang.SportCredit</div>
        <div class="col-xs-6 col-sm-6 col-md-6 text-right"><b class="credit">@customer.SportCredit.Format(2)</b></div>
    </div>
</div>
<div class="row">
    <div class="col-xs-12 col-sm-12 col-md-12">
        <!-- Nav tabs -->
        <ul class="nav nav-tabs search-member">
            <li class="setting active"><a href="#home" data-toggle="tab">@ViewLang.Setting</a></li>
        </ul>
        <!-- Tab panes -->
        <div class="tab-content">
            <div class="tab-pane active" id="home">
                <ul class="super-menu list-unstyled">
                    <li><a href="#"><span class="icon-row-right"></span>@ViewLang.ShareSetting</a></li>
                    <li><a href="#"><span class="icon-row-right"></span>@ViewLang.BetAndCommSetting</a></li>
                    <li><a href="#"><span class="icon-row-right"></span>@ViewLang.ShareHierachy</a></li>
                    <li><a href="#"><span class="icon-row-right"></span>@ViewLang.CommHierachy</a></li>
                    <li><a href="#"><span class="icon-row-right"></span>@ViewLang.UserLog</a></li>
                </ul>
            </div>
        </div>
    </div>
</div>