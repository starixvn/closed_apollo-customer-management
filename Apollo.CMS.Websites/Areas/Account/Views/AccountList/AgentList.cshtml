@{
    var agentId = (int)ViewBag.AgentId;
    
    ViewBag.Title = ViewLang.AgentList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/styles/fanexGrid")
    @Styles.Render("~/site/accountList")
}
@section HeadLine {
    <h5 class="row title">
        <span class="txt-title">@ViewLang.AgentList</span>
        <div class="btn-switch">
            <a href="#" class="switch-link"><span class="icon-list"></span> @ViewLang.MemberList</a>
            <a href="#" class="switch-link"><span class="icon-list"></span> @ViewLang.ShadowList</a>
        </div>
    </h5>
}
@Html.Hidden("hdnAgentId", agentId)

<div class="row filter-form clearfix resizable-form" data-original-width="862">
    <div class="filter-row clearfix">
        <div class="filter-item">
            <div class="lbl width-auto">
                @Html.Label("txtUsername", ViewLang.UserName)
            </div>
            <div class="txt width-auto">
                @Html.TextBox("txtUsername")
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl lbl-small">            
                @Html.Label("ddlStatus", ViewLang.Status)
            </div>
            <div class="txt width-auto">
                @Html.DropDownList("ddlStatus", (IEnumerable<SelectListItem>)ViewBag.AccountStatuses)
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl width-auto">
                @Html.Label("ddlBetStatus", ViewLang.BetStatus)
            </div>
            <div class="txt width-auto">
                @Html.DropDownList("ddlBetStatus", (IEnumerable<SelectListItem>)ViewBag.BetStatuses)
            </div>
        </div>
        <div class="filter-item">
            <input id="btnSubmit" type="button" class="btn btn-default" value="@ViewLang.Submit"/>
        </div>
    </div>
</div>
<div class="row breadcrumbs">
    @{ Html.RenderAction("Breadcrumb", "AccountList", new { agentId = agentId }); }
</div>
<div class="row content-grid display-none">
    <div class="freegrid resizable-grid" id="divAgentList"></div>
</div>

@section Foot {
    @Scripts.Render("~/scripts/fanexGrid")
    @Scripts.Render("~/scripts/agentList")

    <script type="text/javascript">
        var tableHeaders = {
        };
    </script>
}