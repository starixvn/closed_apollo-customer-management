@using System.Web.Script.Serialization
@using Apollo.CMS.Core.Constants
@{
    var agentId = (int)ViewBag.AgentId;
    var agentLevel = (int)ViewBag.AgentLevel;
    var pageSize = (int)ViewBag.PageSize;
    var isSuper = agentLevel == (int)HighLevelAgents.Super;
    var hasMember = agentLevel > (int)HighLevelAgents.MainShareholder;
    
    ViewBag.Title = ViewLang.AgentList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/styles/fanexGrid")
    @Styles.Render("~/site/accountList")
}
@section HeadLine {
    <h5 class="row title">
        <span class="txt-title">@ViewLang.AgentList</span>
        <div class="btn-switch">
            @if (agentLevel > (int)HighLevelAgents.Shareholder)
            {
                <a href="@Url.Action("MemberList", "AccountList", new { agentId = agentId, agentLevel = agentLevel })" class="switch-link">
                    <span class="icon-list"></span> @ViewLang.MemberList
                </a>
            }
            
            <a href="@Url.Action("ShadowtList", "AccountList", new { agentId = agentId, agentLevel = agentLevel })" class="switch-link">
                <span class="icon-list"></span> @ViewLang.Shadow
            </a>
        </div>
    </h5>
}

<div id="divFilterForm" class="row filter-form clearfix resizable-form filter-mainAgent" data-original-width="858">
    <div class="filter-row clearfix">
        <div class="filter-item">
            <div class="lbl width-auto">
                @Html.Label("txtUsername", ViewLang.UserName)
            </div>
            <div class="txt width-auto">
                @Html.TextBox("txtUsername")
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl lbl-small">            
                @Html.Label("ddlStatus", ViewLang.Status)
            </div>
            <div class="txt width-auto">
                @Html.DropDownList("ddlStatus", (IEnumerable<SelectListItem>)ViewBag.AccountStatuses)
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl width-auto">
                @Html.Label("ddlBetStatus", ViewLang.BetStatus)
            </div>
            <div class="txt width-auto">
                @Html.DropDownList("ddlBetStatus", (IEnumerable<SelectListItem>)ViewBag.BetStatuses)
            </div>
        </div>
        <div class="filter-item">
            <input id="btnSubmit" type="button" class="btn btn-default" value="@ViewLang.Submit"/>
        </div>
    </div>
</div>
<div class="row breadcrumbs">
    @{ Html.RenderAction("Breadcrumb", "AccountList", new { agentId = agentId }); }
</div>
<div class="row content-grid">
    <div id="divAgentList" class="freegrid hide resizable-grid"></div>
</div>
<div id="divContextMenu" class="hide">
    <ul>
        <li><a href="#">@ViewLang.ShareSetting</a></li>
        <li><a href="#">@ViewLang.MemberShareSetting</a></li>
        <li><a href="#">@ViewLang.BetAndCommSetting</a></li>
    </ul>
</div>

@section Foot {
    @Scripts.Render("~/scripts/fanexGrid")
    @Scripts.Render("~/scripts/agentList")

    <script type="text/javascript">
        var tableHeaders = {
            No: '#',
            Edit: '@ViewLang.Edit',
            Username: '@ViewLang.UserName',
            Downline: '@ViewLang.Downline',
            Member: '@ViewLang.Member',
            Shadow: '@ViewLang.Shadow',
            Status: '@ViewLang.Status',
            BetStatus: '@ViewLang.BetStatus',
            Currency: '@ViewLang.Currency'
        };
        var agentId = @agentId;
        var pageSize = @pageSize;
        var isSuper = '@isSuper' === 'True';
        var hasMember = '@hasMember' === 'True';
        var pageRanges = @Html.Raw(new JavaScriptSerializer().Serialize(ViewBag.PageRanges));
    </script>
}