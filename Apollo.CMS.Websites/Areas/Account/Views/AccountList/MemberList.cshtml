@{
    var agentId = (int)ViewBag.AgentId;
    var agentLevel = (int)ViewBag.AgentLevel;
    var pageSize = (int)ViewBag.PageSize;

    ViewBag.Title = ViewLang.MemberList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/styles/fanexGrid")
    @Styles.Render("~/site/accountList")
}
@section HeadLine {
    <h5 class="row title">
        <span class="txt-title">@ViewLang.MemberList</span>
        <div class="btn-switch">
            <a href="@Url.Action("AgentList", "AccountList", new { agentId = agentId, agentLevel = agentLevel })" class="switch-link">
                    <span class="icon-list"></span> @ViewLang.AgentList
                </a>
            <a href="@Url.Action("ShadowList", "AccountList", new { agentId = agentId, agentLevel = agentLevel })" class="switch-link">
                <span class="icon-list"></span> @ViewLang.Shadow
            </a>
        </div>
    </h5>
}

<div id="divFilterForm" class="row filter-form clearfix resizable-form memberList" data-original-width="862">
    <div class="filter-row clearfix">
        <div class="filter-item">
            <div class="lbl width-auto">
                @Html.Label("txtUsername", ViewLang.UserName)
            </div>
            <div class="txt width-auto">
                @Html.TextBox("txtUsername")
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl lbl-small">
                @Html.Label("ddlStatus", ViewLang.Status)
            </div>
            <div class="txt width-auto">
                @Html.DropDownList("ddlStatus", (IEnumerable<SelectListItem>)ViewBag.AccountStatuses)
            </div>
        </div>
        <div class="filter-item">
            <div class="lbl width-auto">
                @Html.Label("ddlBetStatus", ViewLang.BetStatus)
            </div>
            <div class="txt width-auto">
                @Html.DropDownList("ddlBetStatus", (IEnumerable<SelectListItem>)ViewBag.BetStatuses)
            </div>
        </div>
        <div class="filter-item">
            <input id="btnSubmit" type="button" class="btn btn-default" value="@ViewLang.Submit"/>
        </div>
    </div>
</div>
<div class="row breadcrumbs">
    @{ Html.RenderAction("Breadcrumb", "AccountList", new { agentId = agentId }); }
</div>
<div class="row content-grid display-none">
    <div class="freegrid resizable-grid" id="divMemberList"></div>
</div>

@section Foot {
    @Scripts.Render("~/scripts/fanexGrid")
    @Scripts.Render("~/scripts/memberList")

    <script type="text/javascript">
        var tableHeaders = {
            No: '#',
            Edit: '@ViewLang.Edit',
            Username: '@ViewLang.UserName',
            Status: '@ViewLang.Status',
            BetStatus: '@ViewLang.BetStatus',
            CommGroup: '@ViewLang.CommGroup',
            SportCredit: '@ViewLang.SportCredit',
            BetAndCommSetting: '@ViewLang.BetAndCommSetting'
        };
        var agentId = @agentId;
        var pageSize = @pageSize;
    </script>
}