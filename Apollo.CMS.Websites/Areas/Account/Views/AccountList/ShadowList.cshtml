@{
    var agentId = (int)ViewBag.AgentId;

    ViewBag.Title = ViewLang.ShadowList;
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section Head {
    @Styles.Render("~/styles/fanexGrid")
    @Styles.Render("~/site/accountList")
}
@section HeadLine {
    <h5 class="row title">
        <span class="txt-title">@ViewLang.ShadowList</span>
        <div class="btn-switch">
            <a href="#" class="switch-link"><span class="icon-list"></span>@ViewLang.AgentList</a>
            <a href="#" class="switch-link"><span class="icon-list"></span>@ViewLang.MemberList</a>
        </div>
    </h5>
}
@Html.Hidden("hdnAgentId", agentId)
<div class="row breadcrumbs shadowList">
    @{ Html.RenderAction("Breadcrumb", "AccountList", new { agentId = agentId }); }
</div>
<div class="row content-grid">
    <div id="divShadowList" class="freegrid hide resizable-grid"></div>
</div>

@section Foot {
    @Scripts.Render("~/scripts/fanexGrid")
    @Scripts.Render("~/scripts/shadowList")

    <script type="text/javascript">
        var tableHeaders = {
            No: '#',
            Edit: '@ViewLang.Edit',
            Shadow: '@ViewLang.Shadow',
            RegisterDate: '@ViewLang.RegisterDate',
            Status: '@ViewLang.Status'
        };
    </script>
}