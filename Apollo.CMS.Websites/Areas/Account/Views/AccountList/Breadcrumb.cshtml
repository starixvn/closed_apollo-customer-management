@using Apollo.CMS.Account.Models.AccountList
@using Apollo.CMS.Core.Constants
@model IEnumerable<NavigationPath>

<ul class="list list-unstyled list-inline">
    @{
        int numberOfItems = Model.Count();
        string currency = null;
        string noIconCss = null;
        NavigationPath item = null;

        for (int index = 0; index < numberOfItems; index++)
        {
            item = Model.ElementAt(index);
            currency = item.AgentLevel == (int)HighLevelAgents.MainShareholder ? string.Format("<span class='currency'>({0})</span>", item.Currency) : string.Empty;
            noIconCss = index == numberOfItems - 1 ? "class=none-icon" : string.Empty;
            
            <li @noIconCss><a href="@Url.Action("AgentList", "AccountList", new { agentId = item.AgentId, agentLevel = item.AgentLevel })">@Html.Raw(string.Format("{0} {1}", item.Username, currency))</a></li>
        }
    }
</ul>