@{
    ViewBag.Title = ViewLang.AgentHierarchy;
    Layout = "~/Views/Shared/_PageLayout.cshtml";
    var agentId = ViewBag.AgentId;
    var username = ViewBag.Username;

}
@section Head
{
    @Styles.Render("~/site/treeView")
}
<h5 class="title">
    @ViewLang.AgentHierarchy
</h5>
<div id="wrapper">
    <ul id="account-treeview" class="tree-sub" data-agent-id="@agentId" data-agent-username="@username">
    </ul>
</div>
@section Foot {
    @Scripts.Render("~/scripts/treeView")
    <script type="text/javascript">
        var nodata = '@ViewLang.NoData';
    </script>
}